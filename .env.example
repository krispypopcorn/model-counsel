# Required only for a live run. Never commit populated values.
OPENAI_API_KEY=
SERPER_API_KEY=

# Project-relative paths
MODEL_COUNSEL_PROJECT_ROOT=.
MASTER_CONTEXT_PATH=examples/synthetic_context.md
EVIDENCE_INPUT_DIR=examples/data
OUTPUT_DIR=outputs
CREWAI_STORAGE_DIR=.model_counsel

# Models: static role-based selection, not dynamic routing
WORKER_MODEL=openai/gpt-5.4-mini
FINAL_MODEL=openai/gpt-5.6-terra

# Execution
RUN_MODE=discovery
VERBOSE=false
ENABLE_CACHE=false
CREWAI_TRACING_ENABLED=false
OPENAI_MAX_RETRIES=1
MAX_RPM=6
MAX_EXECUTION_SECONDS=600

# Completion-token ceilings
SCOUT_MAX_COMPLETION_TOKENS=8000
RESEARCHER_MAX_COMPLETION_TOKENS=9000
CRITIC_MAX_COMPLETION_TOKENS=8000
FINAL_MAX_COMPLETION_TOKENS=14000
TOOL_MAX_COMPLETION_TOKENS=1200

# Agent iterations and prompt-level research budgets
SCOUT_MAX_ITER=6
RESEARCHER_MAX_ITER=14
CRITIC_MAX_ITER=4
STRATEGIST_MAX_ITER=1
SEARCH_RESULTS_PER_QUERY=6
SCOUT_SEARCH_LIMIT=6
RESEARCHER_SEARCH_LIMIT=5
RESEARCHER_SCRAPE_LIMIT=6
CRITIC_SEARCH_LIMIT=4

# Planning guardrail only; this is not a provider-side spending cap.
TARGET_RUN_BUDGET_USD=5.00
EVIDENCE_PACK_MAX_CHARACTERS=80000
